# StayNest Full-Stack PG & Hostel SaaS Environment Variables

# Backend Port
PORT=3001

# Database URL (PostgreSQL managed via Prisma ORM)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/staynest?sslmode=require"

# JWT Secret for Authentication Token Generation
JWT_SECRET="staynest-production-secret-key-2026"

# Frontend Vite Port
VITE_PORT=5175
VITE_API_URL="http://localhost:3001/api"
